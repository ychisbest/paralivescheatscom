---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const cheats = [
  { code: 'JACKPOT', desc: '+50 000 Paradimes' },
  { code: 'MAKEITRAIN', desc: '+10 000 Paradimes' },
  { code: 'PIGGYBANK', desc: '+1 000 Paradimes' },
  { code: 'SETMONEY 20000', desc: 'Fixe le solde exact' },
  { code: 'PRINTMONEY 20000', desc: 'Ajoute au solde actuel' },
  { code: 'PAYDAY', desc: 'Salaire du Para sélectionné' },
  { code: 'FILLALLNEEDS', desc: 'Remplit tous les besoins' },
  { code: 'FREEZENEEDS', desc: 'Gèle les besoins' },
  { code: 'SETSKILLLEVEL Cooking 10', desc: 'Niveau de compétence' },
  { code: 'GETPREGNANT 1', desc: 'Grossesse (1–3)' },
  { code: 'GIVEBIRTH', desc: 'Accouchement immédiat' },
  { code: 'UNSTUCK', desc: 'Débloque le Para sélectionné' },
  { code: 'FIXOUTAGE', desc: 'Répare une coupure de courant' },
  { code: 'HELP', desc: 'Liste des commandes' },
];

const faqs = [
  { q: 'Paralives a-t-il des cheats ?', a: 'Oui, via la console intégrée.' },
  { q: 'Faut-il activer les triches avant ?', a: 'Non — ouvrez la console et tapez directement.' },
  { q: 'Meilleur code argent ?', a: 'JACKPOT pour un gros ajout rapide, ou SETMONEY pour un montant précis. Voir /money-cheats.' },
  { q: 'Comment téléporter / débloquer un Para ?', a: 'UNSTUCK (ou UNSTUCKALL) — voir /teleport-cheats.' },
  { q: 'Trainer externe ?', a: 'Souvent inutile : comparez sur /paralives-trainer.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---

<Layout
  title="Code Triche Paralives"
  fullTitle="Code Triche Paralives 2026 – Codes de Triche (Argent, Besoins, Console) | Paralives Cheats"
  description="Codes de triche Paralives : ouvrir la console, JACKPOT, SETMONEY, FILLALLNEEDS, UNSTUCK et plus. Guide code triche / code de triche pour l’Early Access."
  canonicalPath="/code-triche-paralives"
  schema={[faqSchema]}
  lang="fr"
>
  <Breadcrumb items={[
    { name: 'Home', href: '/' },
    { name: 'Code Triche Paralives' }
  ]} />

  <header class="max-w-7xl mx-auto px-6 py-16 md:py-24 text-center">
    <p class="text-sm font-bold text-gray-400 mb-4 uppercase tracking-wider">Mis à jour : Octobre 2026</p>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-[1.1] mb-6">
      <span class="bg-[#6366f1] text-white px-3 py-1 border border-black inline-block rotate-[-1deg]">Code triche</span> Paralives
    </h1>
    <p class="text-xl text-gray-700 max-w-2xl mx-auto leading-relaxed font-medium mb-6">
      Vous cherchez un <strong>code triche Paralives</strong> ou des <strong>codes de triche</strong> pour l’Early Access ? Paralives inclut une <strong>console intégrée</strong> : aucun toggle du type testingcheats n’est requis. Ouvrez la console, saisissez un code, validez.
    </p>
    <p class="text-lg text-gray-500 font-bold">
      Windows : <span class="bg-[#FFD54F] px-2 border-2 border-black">Ctrl + Shift + C</span> ou <span class="bg-[#FFD54F] px-2 border-2 border-black">Ctrl + F1</span>
    </p>
  </header>

  <section class="py-16 bg-white border-y-[3px] border-black">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-[#EEF2FF] border border-black rounded-3xl p-8 brutal-shadow mb-12">
        <h2 class="text-2xl font-extrabold mb-4">Ouvrir la console</h2>
        <ul class="space-y-2 text-gray-800 font-medium text-lg mb-4">
          <li>Windows : <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">Ctrl + Shift + C</code> ou <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">Ctrl + F1</code></li>
          <li>macOS : <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">Command + Fn/Globe + F1</code> (selon le clavier)</li>
        </ul>
        <p class="text-gray-700 font-medium text-lg">
          La console peut démarrer réduite en haut à droite — développez-la si besoin. Tapez <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">HELP</code> pour voir les commandes de <strong>votre</strong> build. Guide détaillé (EN) : <a href="/how-to-enable-paralives-cheats" class="text-[#6366f1] font-extrabold underline underline-offset-4 decoration-2">how to enable cheats</a>. Liste complète : <a href="/cheat-codes" class="text-[#6366f1] font-extrabold underline underline-offset-4 decoration-2">cheat codes</a>.
        </p>
      </div>

      <h2 class="text-3xl font-extrabold mb-4">Codes de triche populaires</h2>
      <p class="text-gray-600 font-medium mb-8">Utilisez les <strong>noms de commandes anglais</strong> tels qu’affichés dans le jeu (non sensibles à la casse).</p>
      <div class="space-y-3 mb-8">
        {cheats.map(cheat => (
          <div class="flex items-center justify-between gap-4 bg-[#F9FAFB] border border-black rounded-2xl p-4 md:p-5 brutal-shadow">
            <div class="flex-1 min-w-0">
              <code class="bg-[#6366f1] text-white px-3 py-1 rounded-full text-sm font-bold border border-black">{cheat.code}</code>
              <span class="ml-3 text-gray-700 font-medium">{cheat.desc}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="text-gray-700 font-medium text-lg mb-8">
        Pour l’<strong>argent infini</strong> et le détail SETMONEY / PRINTMONEY : <a href="/money-cheats" class="text-[#6366f1] font-extrabold underline underline-offset-4 decoration-2">money cheats</a>. Pour remplir les besoins : <a href="/needs-cheats" class="text-[#6366f1] font-extrabold underline underline-offset-4 decoration-2">needs cheats</a>.
      </p>

      <h2 class="text-3xl font-extrabold mb-4">Comment utiliser un code de triche</h2>
      <ol class="space-y-3 text-gray-800 font-medium list-decimal list-inside text-lg mb-4">
        <li>Chargez un foyer / terrain.</li>
        <li>Sélectionnez le Para concerné si le code est lié au personnage.</li>
        <li>Ouvrez la console.</li>
        <li>Saisissez le code (exemple : JACKPOT) puis Entrée.</li>
        <li>Sauvegardez avant les commandes destructives (KILL, feux, SPAWNALLITEMS).</li>
      </ol>
      <p class="text-gray-700 font-medium text-lg">Les codes évoluent en Early Access : en cas d’échec, relancez HELP.</p>
    </div>
  </section>

  <section class="py-16 bg-[#F9FAFB] border-b-[3px] border-black">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold mb-8 text-center">FAQ – code triche Paralives</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border border-black rounded-2xl p-6 bg-white brutal-shadow">
            <h3 class="text-xl font-extrabold mb-2">{faq.q}</h3>
            <p class="text-gray-700 font-medium text-lg">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#E0F2FE] border-b-[3px] border-black">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-extrabold mb-4">Pages liées</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/cheat-codes" class="bg-white border border-black rounded-2xl p-6 brutal-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all block">
          <h3 class="font-extrabold text-lg mb-1">Tous les cheat codes</h3>
          <p class="text-gray-600 font-medium">Liste complète</p>
        </a>
        <a href="/money-cheats" class="bg-white border border-black rounded-2xl p-6 brutal-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all block">
          <h3 class="font-extrabold text-lg mb-1">Money cheats</h3>
          <p class="text-gray-600 font-medium">Argent &amp; JACKPOT</p>
        </a>
        <a href="/needs-cheats" class="bg-white border border-black rounded-2xl p-6 brutal-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all block">
          <h3 class="font-extrabold text-lg mb-1">Needs cheats</h3>
          <p class="text-gray-600 font-medium">FILLALLNEEDS</p>
        </a>
        <a href="/how-to-enable-paralives-cheats" class="bg-white border border-black rounded-2xl p-6 brutal-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all block">
          <h3 class="font-extrabold text-lg mb-1">Activer la console (EN)</h3>
          <p class="text-gray-600 font-medium">How to enable</p>
        </a>
        <a href="/paralives-trucchi" class="bg-white border border-black rounded-2xl p-6 brutal-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all block">
          <h3 class="font-extrabold text-lg mb-1">Paralives Trucchi (IT)</h3>
          <p class="text-gray-600 font-medium">Version italienne</p>
        </a>
        <a href="/paralives-kody" class="bg-white border border-black rounded-2xl p-6 brutal-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all block">
          <h3 class="font-extrabold text-lg mb-1">Paralives Kody (PL)</h3>
          <p class="text-gray-600 font-medium">Version polonaise</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
