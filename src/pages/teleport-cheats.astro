---
import Layout from '../layouts/Layout.astro';
import CheatTable from '../components/CheatTable.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const cheats = [
  { code: 'UNSTUCK', desc: 'Move the selected Para to the correct navmesh position.' },
  { code: 'UNSTUCKALL', desc: 'Move all Paras to correct navmesh positions.' },
];

const faqs = [
  { q: 'How do I teleport a Para in Paralives?', a: 'Select the stuck Para, open the cheat console, and type "UNSTUCK". Paralives uses this pathing fix as the practical teleport command because it moves the selected Para back to a valid navmesh position.' },
  { q: 'How do I teleport Paras in Paralives?', a: 'Use "UNSTUCK" for one selected Para. If multiple Paras are stuck or trapped, use "UNSTUCKALL" to move every Para back to valid navmesh positions.' },
  { q: 'What is the Paralives teleport command?', a: 'The command to use is "UNSTUCK" for one selected Para or "UNSTUCKALL" for every Para in the world. There is not a separate free-map teleport command in the current Early Access cheat list.' },
  { q: 'What if my Para is stuck?', a: 'Use "UNSTUCK" to fix the selected Para\'s pathing and move them to the correct position. If multiple Paras are stuck, use "UNSTUCKALL" to fix everyone in the world at once.' },
  { q: 'What does UNSTUCK do exactly?', a: 'The UNSTUCK command moves the selected Para to the correct position on the navigation mesh, fixing any pathing issues that may have caused them to get stuck.' },
  { q: 'Can I fix all stuck Paras at once?', a: 'Yes! Use "UNSTUCKALL" to fix pathing for every Para in the world. This is great for mass pathing bugs.' },
  { q: 'Are there teleport cheats in Paralives?', a: 'The UNSTUCK and UNSTUCKALL commands are the primary location-fixing cheats. For more debug commands, check the full cheats list.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to teleport a Para in Paralives",
  "description": "Move a stuck Para back to a valid position with the UNSTUCK command.",
  "step": [
    { "@type": "HowToStep", "name": "Select the Para", "text": "Click the Para that is stuck or needs to be moved back to a valid pathing position." },
    { "@type": "HowToStep", "name": "Open the cheat console", "text": "Press Ctrl + F1 or Ctrl + Shift + C on Windows. On Mac, use the shortcut supported by your keyboard layout." },
    { "@type": "HowToStep", "name": "Run UNSTUCK", "text": "Type UNSTUCK and press Enter to move the selected Para to the correct navmesh position." },
    { "@type": "HowToStep", "name": "Use UNSTUCKALL if needed", "text": "If several Paras are trapped, type UNSTUCKALL to fix every Para in the world at once." }
  ]
};

const relatedPages = [
  { title: 'Needs Cheats', href: '/needs-cheats', desc: 'Fill all needs instantly' },
  { title: 'Power Outage Cheats', href: '/power-outage-cheats', desc: 'Fix lot utility problems' },
  { title: 'WeMod Trainer', href: '/wemod-trainer', desc: 'Use the built-in console instead' },
  { title: 'Money Cheats', href: '/money-cheats', desc: 'Get unlimited Paradimes' },
  { title: 'Console Commands', href: '/console-commands', desc: 'How to use the console' },
];
---

<Layout
  title="Teleport Cheats"
  fullTitle="How to Teleport in Paralives 2026 - UNSTUCK Command Guide | Paralives Cheats"
  description="How to teleport a Para in Paralives with UNSTUCK and UNSTUCKALL. Fix stuck Paras, move them to valid navmesh positions, and avoid unsupported commands."
  canonicalPath="/teleport-cheats"
  schema={[faqSchema, howToSchema]}
>
  <Breadcrumb items={[
    { name: 'Home', href: '/' },
    { name: 'Teleport Cheats' }
  ]} />

  <header class="max-w-7xl mx-auto px-6 py-16 md:py-24 text-center">
    <p class="text-sm font-bold text-gray-400 mb-4 uppercase tracking-wider">Updated: June 2026</p>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-[1.1] mb-6">
      How to <span class="bg-[#8b5cf6] text-white px-3 py-1 border border-black inline-block rotate-[-1deg]">Teleport</span> in Paralives
    </h1>
    <p class="text-xl text-gray-700 max-w-2xl mx-auto leading-relaxed font-medium mb-6">
      The practical Paralives teleport command is UNSTUCK. Use it to move the selected Para back to a valid navmesh position, or use UNSTUCKALL when several Paras are trapped.
    </p>
    <p class="text-lg text-gray-500 font-bold">
      Press <span class="bg-[#FFD54F] px-2 border-2 border-black">Ctrl + F1</span> or <span class="bg-[#FFD54F] px-2 border-2 border-black">Ctrl + Shift + C</span>, then type <span class="bg-[#FFD54F] px-2 border-2 border-black">UNSTUCK</span>.
    </p>
  </header>

  <section class="py-16 bg-white border-y-[3px] border-black">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold mb-2">All Teleport Cheat Codes</h2>
      <p class="text-gray-600 font-medium mb-8">Click any code to copy it to your clipboard, then paste into the console.</p>
      <CheatTable cheats={cheats} color="bg-[#8b5cf6]" />

      <div class="mt-12 bg-[#F5F3FF] border border-black rounded-3xl p-8 brutal-shadow">
        <h3 class="text-2xl font-extrabold mb-4">How to Teleport a Para</h3>
        <ol class="space-y-3 text-gray-800 font-medium list-decimal list-inside">
          <li>Select the Para that is stuck or needs to be moved back to a valid pathing position.</li>
          <li>Open the console with <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">Ctrl + F1</code> or <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">Ctrl + Shift + C</code>.</li>
          <li>Type <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">UNSTUCK</code> and press Enter.</li>
          <li>If multiple Paras are stuck, use <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">UNSTUCKALL</code> instead.</li>
        </ol>
      </div>

      <div class="mt-8 bg-white border border-black rounded-3xl p-8 brutal-shadow">
        <h3 class="text-2xl font-extrabold mb-4">Quick Answer for Stuck Paras</h3>
        <p class="text-gray-700 font-medium text-lg mb-4">
          If you searched for how to teleport Paras in Paralives, start with <strong>UNSTUCK</strong>. It moves the selected Para back to a valid route when they are trapped by furniture, terrain, or pathing.
        </p>
        <p class="text-gray-700 font-medium text-lg">
          Use <strong>UNSTUCKALL</strong> only when more than one Para is stuck. For console setup issues, use the <a href="/console-commands" class="text-[#6366f1] font-extrabold underline underline-offset-4 decoration-2">console commands guide</a> before installing any external trainer.
        </p>
      </div>

      <div class="mt-12 bg-[#EDE9FE] border border-black rounded-3xl p-8 brutal-shadow">
        <h3 class="text-2xl font-extrabold mb-4">📍 Teleport Cheat Tips</h3>
        <ul class="space-y-3 text-gray-800 font-medium">
          <li class="flex items-start gap-3">
            <span class="text-xl">🗺️</span>
            <span>If a Para gets stuck, <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">UNSTUCK</code> fixes their pathing and moves them to the correct position.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-xl">🌐</span>
            <span><code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">UNSTUCKALL</code> fixes every Para in the world at once — great for mass pathing bugs.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-xl">💡</span>
            <span>These commands move Paras to the nearest valid position on the navigation mesh.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-xl">🔎</span>
            <span>If you are looking for a free-map teleport command, type <code class="bg-black text-white px-2 py-0.5 rounded-full text-sm font-bold">HELP</code> in your current build to confirm whether a newer Early Access command has been added.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-xl">⚠️</span>
            <span>Always save before using debug commands, just in case.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#F9FAFB] border-b-[3px] border-black">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold mb-8 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="border border-black rounded-2xl p-6 bg-white brutal-shadow">
            <h3 class="text-xl font-extrabold mb-2">{faq.q}</h3>
            <p class="text-gray-700 font-medium text-lg">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#E0F2FE] border-b-[3px] border-black">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold mb-8 text-center">Related Paralives Cheats</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {relatedPages.map(page => (
          <a href={page.href} class="bg-white border border-black rounded-2xl p-6 brutal-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all block">
            <h3 class="font-extrabold text-lg mb-1">{page.title}</h3>
            <p class="text-gray-600 font-medium">{page.desc}</p>
            <span class="font-bold text-[#6366f1] underline underline-offset-4 decoration-2 text-sm">View Cheats →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const copyIcon = btn.querySelector('.copy-icon');
      const checkIcon = btn.querySelector('.check-icon');
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      setTimeout(() => {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 1500);
    });
  });
</script>
