      "@type": "Question",
      "name": "How many cheat codes are in Paralives?",
      "acceptedAnswer": { "@type": "Answer", "text": "Paralives has 92+ cheat codes across 13 categories including money, time, character attributes, needs, pregnancy, aging, career, build mode, fire, mail, debug, performance, and fun Easter eggs." }
    },
    {
      "@type": "Question",
      "name": "What is the most useful cheat in Paralives?",
      "acceptedAnswer": { "@type": "Answer", "text": "The most useful Paralives cheats are: FILLALLNEEDS (fill all needs), SETMONEY (set exact money), SETSKILLLEVEL (max skills), UNSTUCK (fix stuck Paras), and FREEZENEEDS (stop need decay)." }
    },
    {
      "@type": "Question",
      "name": "Where is the full money cheat guide?",
      "acceptedAnswer": { "@type": "Answer", "text": "For infinite money, SETMONEY, JACKPOT, and related money cheat codes, open the dedicated money cheats guide at /money-cheats." }
    }
  ]
};

const relatedPages = [
  { title: 'How to Enable Cheats', href: '/how-to-enable-paralives-cheats', desc: 'Open console & start typing' },
  { title: 'Money Cheats', href: '/money-cheats', desc: 'Infinite money & money cheat codes' },
